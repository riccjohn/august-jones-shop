# Umami Cloud analytics
# Get your website ID from: https://cloud.umami.is → your website → Settings
# Add to .env.local for local development
# Add to Cloudflare Pages environment variables for production
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-website-id-uuid

# Shopify — contact form + email list signup write to Shopify Admin API
# Create a custom app: Shopify admin → Settings → Apps and sales channels → Develop apps
# → Create an app → Configure Admin API scopes: write_customers, read_customers, write_draft_orders
# → Install app → copy the Client ID and Secret from the app's API credentials page
# (the app exchanges these for a short-lived access token per request; there is no static token)
# Add all three to Cloudflare Pages → Settings → Environment Variables (server-only, no NEXT_PUBLIC_ prefix)
SHOPIFY_STORE_DOMAIN=august-jones-2.myshopify.com
SHOPIFY_CLIENT_ID=your_client_id_here
SHOPIFY_CLIENT_SECRET=your_client_secret_here

# Shopify relay (optional) — routes GraphQL through a Fly.io relay for a static egress
# IP instead of calling Shopify directly. Set both on Cloudflare Pages → Settings →
# Environment Variables (server-only), on both Production and Preview, to use it in
# production. Full setup, credential rotation, and rollback: relay/README.md.
#
# RELAY_URL — the relay's base URL.
# RELAY_SHARED_SECRET — shared secret sent as X-Relay-Secret; generate with
#   `openssl rand -hex 32` and set the same value on Fly and Cloudflare.
#
# Leave both commented out for local dev (direct Shopify calls, the default).
# RELAY_URL=https://august-jones-relay.fly.dev
# RELAY_SHARED_SECRET=your_relay_secret_here

# FLY_API_TOKEN is a GitHub Actions secret for the relay's deploy workflow, not an app
# env var — must be app-scoped, never org-wide. See relay/README.md.

# Custom commissions open/closed toggle — LOCAL TESTING ONLY, do not set in Cloudflare Pages.
# Overrides the CUSTOMS_OPEN default (true) in src/lib/config.ts for local `pnpm dev` runs,
# so you can preview the closed-state banner and /contact message without editing code.
# Production toggles via a code change to the DEFAULT_CUSTOMS_OPEN constant + redeploy instead.
NEXT_PUBLIC_CUSTOMS_OPEN=false
