# Umami Cloud analytics
# Get your website ID from: https://cloud.umami.is → your website → Settings
# Add to .env.local for local development
# Add to Cloudflare Pages environment variables for production
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-website-id-uuid

# Shopify — contact form + email list signup write to Shopify Admin API
# Create a custom app: Shopify admin → Settings → Apps and sales channels → Develop apps
# → Create an app → Configure Admin API scopes: write_customers, read_customers, write_draft_orders
# → Install app → copy the Admin API access token
# Add both to Cloudflare Pages → Settings → Environment Variables (server-only, no NEXT_PUBLIC_ prefix)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=shpat_your_admin_api_token_here

# Custom commissions open/closed toggle — LOCAL TESTING ONLY, do not set in Cloudflare Pages.
# Overrides the CUSTOMS_OPEN default (true) in src/lib/config.ts for local `pnpm dev` runs,
# so you can preview the closed-state banner and /contact message without editing code.
# Production toggles via a code change to the DEFAULT_CUSTOMS_OPEN constant + redeploy instead.
NEXT_PUBLIC_CUSTOMS_OPEN=false
